{
  "name": "svelte-attach-sound",
  "version": "0.1.3",
  "description": "A Svelte attachment for binding sound playback to DOM events using the Web Audio API",
  "keywords": [
    "attachment",
    "sound",
    "svelte",
    "svelte5",
    "web-audio"
  ],
  "homepage": "https://github.com/joknoll/svelte-attach-sound#readme",
  "bugs": {
    "url": "https://github.com/joknoll/svelte-attach-sound/issues"
  },
  "license": "MIT",
  "author": "joknoll",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joknoll/svelte-attach-sound.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "bumpp": "^11.0.1",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "svelte": "^5.55.0",
    "tsdown": "^0.21.4",
    "typescript": "^6.0.2",
    "vitest": "^4.1.1"
  },
  "peerDependencies": {
    "svelte": ">=5.55.0"
  }
}
